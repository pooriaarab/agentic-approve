{
  "author": "Pooria Arab",
  "bin": {
    "agentic-approve": "./dist/cli.js",
    "agentic-approve-mcp": "./dist/mcp-bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-core": "0.1.0",
    "zod": "^3.25.0"
  },
  "description": "A human review and approval queue for AI agent output, with a Node.js SDK, CLI, MCP server, audit log, and Cloudflare adapters.",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "server.json",
    ".mcp.json",
    "AGENTS.md",
    "RULES.md",
    "SKILL.md",
    "llms.txt",
    "agentic-core.d.ts"
  ],
  "keywords": [
    "approval",
    "review-queue",
    "human-in-the-loop",
    "ai-agents",
    "audit-log",
    "nodejs",
    "typescript",
    "cli",
    "mcp",
    "cloudflare",
    "cloudflare-d1",
    "cloudflare-r2",
    "cloudflare-access",
    "agentic-core"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "mcpName": "io.github.pooriaarab/agentic-approve",
  "name": "agentic-approve",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-approve.git"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.1"
}
